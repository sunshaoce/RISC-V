<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>name</key>
    <string>RISC-V Assembler (spacemit)</string>
    <key>scopeName</key>
    <string>source.riscv.spacemit</string>
    <key>patterns</key>
    <array>
      <dict>
        <key>include</key>
        <string>source.riscv</string>
      </dict>

      <!-- spacemit IME integer instructions -->
      <dict>
        <key>comment</key>
        <string>SpacemiT IME integer matrix multiply-accumulate</string>
        <key>match</key>
        <string>(?ix)\b(
          smt\.vmadot([123n])?(u|su|us)?
          )\b</string>
        <key>name</key>
        <string>support.function.riscv.xsmtvdot</string>
      </dict>

      <!-- spacemit IME floating-point instructions -->
      <dict>
        <key>comment</key>
        <string>SpacemiT IME floating-point matrix multiply-accumulate</string>
        <key>match</key>
        <string>(?ix)\b(
          smt\.vfmadot[123n]?
          )\b</string>
        <key>name</key>
        <string>support.function.riscv.xsmtvdot</string>
      </dict>
    </array>
  </dict>
</plist>
