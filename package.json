{
  "name": "RISC-V",
  "displayName": "RISC-V",
  "description": "Most Comprehensive RISC-V ASM Highlighting",
  "version": "1.165.20",
  "publisher": "sunshaoce",
  "homepage": "https://github.com/sunshaoce/RISC-V",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/sunshaoce/RISC-V"
  },
  "bugs": {
    "url": "https://github.com/sunshaoce/RISC-V/issues",
    "email": "sunshaoce@outlook.com"
  },
  "engines": {
    "vscode": "^1.50.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "main": "hover/extension.js",
  "activationEvents": [
    "onLanguage:riscv"
  ],
  "contributes": {
    "configuration": {
      "title": "RISC-V",
      "properties": {
        "riscv.vendor": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "spacemit",
            "sifive"
          ],
          "description": "Select a vendor extension set to highlight. Valid values: (none), spacemit, sifive.",
          "enumDescriptions": [
            "None (no vendor extension highlighting)",
            "SpacemiT vendor extensions (e.g., xsmtvdot)",
            "SiFive vendor extensions (e.g., xsfvfexp)"
          ]
        }
      }
    },
    "languages": [
      {
        "id": "riscv",
        "aliases": [
          "RISC-V",
          "riscv"
        ],
        "extensions": [
          ".S",
          ".s",
          ".riscv",
          ".asm"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "riscv-spacemit",
        "aliases": [
          "RISC-V (spacemit)"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "riscv-sifive",
        "aliases": [
          "RISC-V (sifive)"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "riscv",
        "scopeName": "source.riscv",
        "path": "./syntaxes/riscv.tmLanguage"
      },
      {
        "language": "riscv-spacemit",
        "scopeName": "source.riscv.spacemit",
        "path": "./syntaxes/riscv-spacemit.tmLanguage"
      },
      {
        "language": "riscv-sifive",
        "scopeName": "source.riscv.sifive",
        "path": "./syntaxes/riscv-sifive.tmLanguage"
      }
    ],
    "snippets": [
      {
        "language": "riscv",
        "path": "./snippets/snippets.json"
      }
    ]
  }
}
